# Example environment for the local Docker stack.
#
# Copy this file to .env.docker and adjust the values before starting:
#   copy .env.docker.example .env.docker        (Windows)
#   cp .env.docker.example .env.docker          (Linux and macOS)
#
# .env.docker is git ignored and is the only place local credentials belong.

COMPOSE_PROJECT_NAME=invoiceninja

# Host port mappings (non-default host ports; container ports stay standard)
APP_FORWARD_PORT=9080
DB_FORWARD_PORT=13306
REDIS_FORWARD_PORT=13079

# Application
APP_NAME="Invoice Ninja"
APP_ENV=local
APP_DEBUG=true
APP_KEY=base64:CHANGE_ME_GENERATE_WITH_php_artisan_key_generate
APP_URL=http://localhost:9080

NINJA_ENVIRONMENT=selfhost
IS_DOCKER=true
# This repository ships the Flutter admin bundle, not the React admin bundle,
# so the account is switched to the Flutter application after creation.
REACT_APP_ENABLED=false
# Force every account to the Flutter admin app on container start.
FORCE_FLUTTER_ADMIN=1
# Seed reference data (languages, currencies, countries, designs) on a fresh database.
RUN_SEEDER=1
REQUIRE_HTTPS=false
MULTI_DB_ENABLED=false
DISABLE_AUTO_UPDATE=true
PDF_GENERATOR=snappdf
# Chromium is installed in the app image and used by the snappdf PDF generator.
SNAPPDF_CHROMIUM_PATH=/usr/bin/chromium

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Primary database
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ninja
DB_USERNAME=ninja
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root
DB_STRICT=false

# Test database used by the PHPUnit suite (connection db-ninja-03)
DB_HOST3=db
DB_PORT3=3306
DB_DATABASE3=ninja_test
DB_USERNAME3=ninja
DB_PASSWORD3=change-me

# Cache, sessions and queues
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
BROADCAST_DRIVER=log
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default

# Mail (writes to storage/logs)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=admin@example.com
MAIL_FROM_NAME="Invoice Ninja"

# Disable external search and error reporting for local runs
SCOUT_DRIVER=null
SENTRY_LARAVEL_DSN=

# Montenegro EFI fiscal records are legal documents retained for this many days
# before the weekly retention job may purge them (0 keeps them forever).
MONTENEGRO_FISCAL_LOG_RETENTION_DAYS=3650
# Upper bound for a single JSON fiscal journal export.
MONTENEGRO_FISCAL_LOG_EXPORT_LIMIT=50000

# Backup service
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL=86400
BACKUP_DATABASES=ninja
