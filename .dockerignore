.git
.github
.gitignore
.dockerignore
.editorconfig
.idea
.vscode

# Dependencies are installed inside the image
vendor
node_modules

# Local environment and secrets must never enter the image
.env
.env.*
!.env.example
!.env.docker.example

# Runtime state
public/storage
storage/logs/*.log
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php

# Build and test artifacts
coverage
tests/e2e/report
*.log
.DS_Store
Thumbs.db

# Backup output must never enter the build context
backups
exports
storage/app/flutter-admin-backup-*
storage/app/public/*
public/main.profile.dart.js
public/*.dart.js.map

# Local notes and third-party regulatory documents
backup_docker_container.txt
deploy_one_command.txt
dep_marko.txt
_ide_helper_custom.php
Fiskalni*
